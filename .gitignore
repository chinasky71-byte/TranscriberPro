# Crea/aggiorna .gitignore
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/

# Test e Debug
test_*.py
debug_*.py
check_*.py
fix_*.py
restore_*.py
*_test.py

# Backup
*.backup
*backup*.py
old_*.py
bak_*.py

# Credenziali
*credentials*
*api_key*
*.env

# Log
*.log

# Temp
temp/
cache/
"@ | Out-File -FilePath .gitignore -Encoding UTF8
# Token HuggingFace
huggingface_download_token.txt
huggingface_write_token.txt

# Modelli GGUF (troppo grandi per Git)
*.gguf

# Script di lavoro / speed-fix (non codice di produzione)
speed_fix_*.py
speed_*.py
