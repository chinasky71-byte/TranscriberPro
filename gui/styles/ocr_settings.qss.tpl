QGroupBox {
    font-weight: bold;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: {{white}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLabel#commentLabel {
    color: {{legacy_grey_ccc}};
    font-size: 9pt;
    font-style: italic;
    font-weight: normal;
    padding: 0 0 6px 22px;
}

QRadioButton {
    color: {{white}};
    font-size: 9pt;
    spacing: 8px;
    padding: 3px;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: rgba(45, 45, 45, 200);
    color: {{white}};
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 4px 6px;
}
